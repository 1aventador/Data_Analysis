	column 'Price Point' =
			
			SWITCH(
			    TRUE(),
			    'Product Lookup'[ProductPrice] > 500, "High",
			    'Product Lookup'[ProductPrice] > 100, "Mid-Range",
			    "Low"
			)
		lineageTag: 79dc31ad-73d2-435f-a31d-bbc5f2ef1a11
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'SKU Category' =
			
			LEFT(
			    'Product Lookup'[ProductSKU],
			    SEARCH(
			        "-",
			        'Product Lookup'[ProductSKU]
			    )
			    -1
			)
		lineageTag: f8cc725a-e6a8-4295-ac95-d0e52c52443e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

