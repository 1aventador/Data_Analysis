				    #"Переупорядоченные столбцы" = Table.ReorderColumns(#"Измененный тип1",{"ProductKey", "ProductSubcategoryKey", "ProductSKU", "SKU Type", "ProductName", "ModelName", "ProductDescription", "ProductColor", "ProductSize", "ProductStyle", "ProductCost", "ProductPrice"}),
				    #"Извлеченный текст перед разделителем" = Table.TransformColumns(#"Переупорядоченные столбцы", {{"SKU Type", each Text.BeforeDelimiter(_, "-", 1), type text}}),
				    #"Замененное значение" = Table.ReplaceValue(#"Извлеченный текст перед разделителем","0","NA",Replacer.ReplaceText,{"ProductStyle"}),
				    #"Измененный тип2" = Table.TransformColumnTypes(#"Замененное значение",{{"ProductCost", type number}, {"ProductPrice", type number}}),
				    #"Вставлено: умножение" = Table.AddColumn(#"Измененный тип2", "Умножение", each [ProductPrice] * 0.9, type number),
